{
  "name": "ui24r-virtual-sound-engineer",
  "version": "0.0.0",
  "private": true,
  "description": "Ingeniero de sonido virtual asistido por medici\u00f3n para Soundcraft Ui24R",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/mixer-sim"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "pretest:dsp": "node tools/spikes/p0-10a-dsp/src/generate-signals.mjs",
    "test:dsp": "node --test tools/spikes/p0-10a-dsp/test/*.test.mjs",
    "validate:docs": "node tools/docs/validate-ids.mjs",
    "validate:templates": "node tools/docs/validate-templates.mjs && node tools/docs/validate-plantillas-llamadas.mjs",
    "validate:limites": "node tools/docs/validate-limites.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^22.20.1",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}