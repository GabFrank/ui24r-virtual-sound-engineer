{
  "name": "ui24r-virtual-sound-engineer",
  "version": "0.0.0-semantic-release",
  "private": true,
  "description": "Ingeniero de sonido virtual asistido por medición para Soundcraft Ui24R",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/mixer-sim"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "npm run lint --workspaces --if-present && npm run lint:tools",
    "test": "npm run test --workspaces --if-present",
    "pretest:dsp": "node tools/spikes/p0-10a-dsp/src/generate-signals.mjs",
    "test:dsp": "node --test tools/spikes/p0-10a-dsp/test/*.test.mjs",
    "test:audio": "node --test tools/audio/test-*.mjs",
    "test:guardas": "node --test tools/docs/test/*.test.mjs",
    "validate:docs": "node tools/docs/validate-ids.mjs && node tools/docs/validate-numeros.mjs && node tools/docs/validate-huerfanos.mjs && node tools/docs/validate-fichas.mjs && node tools/docs/validate-capturas.mjs && node tools/docs/validate-cifras-medidas.mjs && node tools/docs/validate-evidencia-archivada.mjs && node tools/docs/validate-huella-de-evidencia.mjs && node tools/docs/validate-trabajo-previo.mjs && node tools/docs/validate-rutas-medidas.mjs",
    "validate:templates": "node tools/docs/validate-templates.mjs && node tools/docs/validate-plantillas-llamadas.mjs",
    "validate:limites": "node tools/docs/validate-limites.mjs && node tools/docs/validate-mediciones-al-historial.mjs && node tools/docs/validate-escucha-anotada.mjs",
    "verificar": "node tools/verificacion/ejecutar.mjs",
    "verificar:commits": "node tools/docs/validate-commits.mjs",
    "lint:tools": "tsc -p tools/tsconfig.json --noEmit",
    "verificar:cambio": "node tools/verificacion/ejecutar.mjs --cambio",
    "test:flujo": "node --test tools/verificacion/test/*.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^22.20.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "esbuild": "0.23.0",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0",
    "semantic-release": "^24.2.9",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
